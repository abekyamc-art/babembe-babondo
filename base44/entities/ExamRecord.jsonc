{
  "name": "ExamRecord",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the student this record belongs to. One record stands for each student, and it is what their standing is written to and found by."
    },
    "username": {
      "type": "string",
      "description": "Public handle shown beside the student on the leaderboard, taken from their profile when the standing was last written down."
    },
    "avatar_url": {
      "type": "string",
      "description": "Public address of the student's picture, as it stood when the standing was last written down."
    },
    "score": {
      "type": "number",
      "default": 0,
      "description": "The student's total score: the best mark of every examination episode they have passed, added together. It is kept beside the one total the leaderboard stands in."
    },
    "passed": {
      "type": "number",
      "default": 0,
      "description": "How many episodes of the examination the student has passed, over every season. It is one of the two parts of the one total the leaderboard shows."
    },
    "game_episodes": {
      "type": "number",
      "default": 0,
      "description": "How many episodes of Find the Differences the student has passed. It is read from the game's own record on their phone each time their standing is written down, and it is the other part of the one total the leaderboard shows."
    },
    "episodes": {
      "type": "number",
      "default": 0,
      "description": "The one total the leaderboard shows and stands in the order of: every episode of the game the student has really passed and every episode of the examination, added together. Five examination episodes and five game episodes read here as ten."
    },
    "season": {
      "type": "number",
      "default": 1,
      "description": "The furthest season the student has reached."
    },
    "episode": {
      "type": "number",
      "default": 1,
      "description": "The episode of that season the student stands on."
    },
    "at": {
      "type": "string",
      "description": "ISO time the standing was last written down."
    }
  },
  "required": [
    "user_email",
    "score"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}