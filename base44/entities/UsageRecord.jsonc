{
  "name": "UsageRecord",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the signed-in user this message belongs to."
    },
    "used_at": {
      "type": "string",
      "description": "The moment the assistant answered the message, as an ISO timestamp. That message comes back to the allowance 24 hours after this moment."
    }
  },
  "required": [
    "user_email",
    "used_at"
  ]
}