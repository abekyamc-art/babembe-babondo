{
  "name": "LiveRoom",
  "type": "object",
  "properties": {
    "host_email": {
      "type": "string",
      "description": "Email of the person who is live."
    },
    "host_username": {
      "type": "string",
      "description": "Public handle of the host while the room is open."
    },
    "host_avatar_url": {
      "type": "string",
      "description": "Public URL of the host's profile picture at the moment the room opened."
    },
    "title": {
      "type": "string",
      "description": "What the host says the live is about."
    },
    "filter": {
      "type": "string",
      "default": "none",
      "description": "Camera filter the host has picked; every phone watching shows the same one."
    },
    "zoom": {
      "type": "number",
      "description": "How far in the host's camera is pulled, as a shared setting for the room's framing."
    },
    "status": {
      "type": "string",
      "enum": [
        "live",
        "ended"
      ],
      "default": "live",
      "description": "Only rooms that are still live appear in the live bar."
    },
    "started_at": {
      "type": "string",
      "description": "ISO time the room went live."
    },
    "ended_at": {
      "type": "string",
      "description": "ISO time the host ended the live."
    }
  },
  "required": [
    "host_email",
    "status",
    "started_at"
  ]
}