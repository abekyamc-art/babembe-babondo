{
  "name": "TrophyCodeCopy",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "The mark's own key: the person's email and the season, joined. One season is taken once, so a second tap finds this key already standing and changes nothing."
    },
    "user_email": {
      "type": "string",
      "description": "Email of the student who took the code. It is read from the signed-in person and never from what was asked, so only their own marks are ever written or read."
    },
    "season": {
      "type": "number",
      "description": "Which season's reward code was taken. The code itself is never kept here \u2014 only the fact that it was taken, which is what takes the full code off the shelf for good."
    },
    "at": {
      "type": "string",
      "description": "ISO time the code was taken."
    }
  },
  "required": [
    "key",
    "user_email",
    "season"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}