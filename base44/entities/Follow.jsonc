{
  "name": "Follow",
  "type": "object",
  "properties": {
    "follower_email": {
      "type": "string",
      "description": "Email of the person doing the following."
    },
    "following_email": {
      "type": "string",
      "description": "Email of the person being followed."
    }
  },
  "required": [
    "follower_email",
    "following_email"
  ],
  "rls": {
    "create": {
      "data.follower_email": "{{user.email}}"
    },
    "read": null,
    "update": {
      "data.follower_email": "{{user.email}}"
    },
    "delete": {
      "data.follower_email": "{{user.email}}"
    }
  }
}