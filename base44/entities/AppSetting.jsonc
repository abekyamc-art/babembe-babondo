{
  "name": "AppSetting",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Which app-level setting this row holds. The voice setting is kept under the key \"voice\"."
    },
    "mode": {
      "type": "string",
      "enum": [
        "agent",
        "base44",
        "mbondo"
      ],
      "default": "agent",
      "description": "Who answers in the app: the original outside voice, the second outside voice that speaks for Base44 mode, or Mbondo AI, who answers both written and spoken questions himself."
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}