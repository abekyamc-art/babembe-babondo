{
  "name": "Story",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "What the story is called, shown beside it in the admin's list and at the head of it on screen."
    },
    "text": {
      "type": "string",
      "description": "The story itself, as the admin wrote it \u2014 the line or the whole telling. It is what the assistant answers from and what the person reads on screen."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The words the story is filed under, so a question about one of them finds it."
    },
    "media_kind": {
      "type": "string",
      "enum": [
        "none",
        "image",
        "video",
        "audio",
        "link"
      ],
      "default": "none",
      "description": "The one thing the admin attached to the story: a picture, a video, an audio recording, or a link that is played outside the app."
    },
    "media_url": {
      "type": "string",
      "description": "Public address of the story's media when it stands at one: a link the admin pasted, or a picture, video or audio recording they gave an address for. It is played where it already stands."
    },
    "media_file_uri": {
      "type": "string",
      "description": "Private storage reference for the picture, video or audio recording the admin uploaded. It is opened through a short-lived link, so it is never public."
    },
    "media_after": {
      "type": "number",
      "description": "How many of the story's lines the attached picture, video, audio recording or link stands after: 0 puts it before the telling, 1 after its first line, and so on. Unset means the story keeps it at the end, after everything \u2014 which is where every story written before this stood."
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reference links the admin attached to the story \u2014 a source, a page, a place to read or watch more."
    },
    "channel_url": {
      "type": "string",
      "description": "The artist's own channel \u2014 their YouTube channel address, or the address of the page where everything they publish is gathered. It stands in a place of its own in the story, apart from the telling and from every other link."
    },
    "artist_links": {
      "type": "array",
      "description": "The videos and other pieces the artist has published, each one its own entry with the name it goes by and the address it stands at. Every entry keeps its own place in the story, one under the other, so a person meets them one at a time.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "What the entry is called, as the artist wrote it \u2014 the name of the video or the piece. It is what the person reads on the button."
          },
          "url": {
            "type": "string",
            "description": "The address the entry opens: the video on YouTube, or the piece wherever it was published."
          }
        },
        "required": [
          "url"
        ]
      }
    },
    "published": {
      "type": "boolean",
      "default": true,
      "description": "Published stories are shown to app users in a call or a written chat; an unpublished story is the admin's own draft and stays private to them."
    }
  },
  "required": [
    "title",
    "text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}