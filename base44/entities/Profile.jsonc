{
  "name": "Profile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the app user this public profile belongs to."
    },
    "username": {
      "type": "string",
      "description": "Public handle shown next to reels, in search and on comments."
    },
    "avatar_url": {
      "type": "string",
      "description": "Public URL of the profile picture."
    },
    "avatar_crop_x": {
      "type": "number",
      "default": 0.5,
      "description": "Where across the picture its round frame is anchored: 0 is the left edge, 0.5 the middle, 1 the right edge. It is the framing chosen when the picture was set."
    },
    "avatar_crop_y": {
      "type": "number",
      "default": 0.5,
      "description": "Where down the picture its round frame is anchored: 0 is the top edge, 0.5 the middle, 1 the bottom edge. It is the framing chosen when the picture was set."
    },
    "coins": {
      "type": "number",
      "default": 0,
      "description": "Coin balance: what is left to spend on boosts, live gifts and extra voice messages."
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": null,
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}