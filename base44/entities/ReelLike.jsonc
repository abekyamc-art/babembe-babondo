{
  "name": "ReelLike",
  "type": "object",
  "properties": {
    "reel_id": {
      "type": "string",
      "description": "The reel that was liked."
    },
    "user_email": {
      "type": "string",
      "description": "Email of the person who liked the reel."
    }
  },
  "required": [
    "reel_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": null,
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}