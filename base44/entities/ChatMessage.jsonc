{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string",
      "description": "The conversation this message belongs to."
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of the two people in the thread. Only they can read this message."
    },
    "sender_email": {
      "type": "string",
      "description": "Email of the person who wrote the message."
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "photo"
      ],
      "default": "text",
      "description": "Photos carry a file reference, text carries words."
    },
    "text": {
      "type": "string",
      "description": "The words, on text messages only."
    },
    "file_uri": {
      "type": "string",
      "description": "Private storage reference for a photo, opened through a short-lived link."
    }
  },
  "required": [
    "thread_id",
    "members",
    "sender_email",
    "kind"
  ],
  "rls": {
    "read": {
      "data.members": "{{user.email}}"
    },
    "create": {
      "data.members": {
        "$in": [
          "{{user.email}}"
        ]
      }
    },
    "update": {
      "data.members": {
        "$in": [
          "{{user.email}}"
        ]
      }
    },
    "delete": {
      "data.members": {
        "$in": [
          "{{user.email}}"
        ]
      }
    }
  }
}