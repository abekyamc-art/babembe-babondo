{
  "name": "KnowledgeDoc",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Which shared document this row belongs to. The one knowledge document every AI answers from is kept under the key \"main\"."
    },
    "kind": {
      "type": "string",
      "enum": [
        "state",
        "draft",
        "published"
      ],
      "default": "state",
      "description": "What the row is: the document's own state \u2014 when it was saved and when it was approved \u2014 or one part of its working copy or of its published text."
    },
    "part": {
      "type": "number",
      "default": 0,
      "description": "Which part of the text the row holds, counting from nothing. The parts are read in this order and joined, and that is the document."
    },
    "text": {
      "type": "string",
      "description": "One part of the document's text. The whole document is larger than one record may hold, so it is kept in parts and read back as one."
    },
    "draft_at": {
      "type": "string",
      "description": "ISO time the working copy was last saved."
    },
    "published_at": {
      "type": "string",
      "description": "ISO time the published document was last approved. Every AI takes a change the moment this moves."
    },
    "published_by": {
      "type": "string",
      "description": "Email of the admin who approved the published document."
    },
    "merged_at": {
      "type": "string",
      "description": "ISO time the older, separate entries and long texts were gathered into the document. It is set once, so what the admin has since written here is never overwritten by that gathering again."
    }
  },
  "required": [
    "key",
    "kind"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}