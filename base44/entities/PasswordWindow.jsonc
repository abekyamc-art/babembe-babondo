{
  "name": "PasswordWindow",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the account this door was opened for. It is the account the row is shown to and the only one it is ever shown to, so a door is never held open for anybody else."
    },
    "opened_at": {
      "type": "string",
      "description": "ISO time the door was first reached. The two hours are counted from this moment, and it is written once."
    },
    "open_until": {
      "type": "string",
      "description": "ISO time the door shuts: two hours after it was first reached. Past this moment the row is gone and no password is taken."
    },
    "used_at": {
      "type": "string",
      "description": "ISO time the password was changed. It is written the moment the change is made, so the door never stands open a second time."
    },
    "note": {
      "type": "string",
      "description": "Anything the app's owner wrote about why this door was opened."
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}